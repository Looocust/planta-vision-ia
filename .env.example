# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Proveedor LLM (agente) ---
LLM_PROVIDER=google_genai
LLM_MODEL=
GOOGLE_API_KEY=
# Pausa mínima entre llamadas al LLM (segundos); útil con cuotas gratuitas
LLM_MIN_INTERVAL_S=0

# --- Seguridad de la demo ---
# Token para endpoints /v1/admin/* y /v1/skus/* del servicio de visión. Cambiarlo.
ADMIN_TOKEN=change-me
# Firma de tokens del agente (genera uno: openssl rand -hex 32). DEMO_LOGIN habilita el login de demo de la UI.
AUTH_SECRET=
DEMO_LOGIN=true
# El agente usa este token para llamar a esos endpoints (debe coincidir con ADMIN_TOKEN).
VISION_ADMIN_TOKEN=change-me
# Permite la cabecera X-Fault (500 | timeout) para demostrar escenarios adversos.
# Poner en false fuera de la demo.
ALLOW_FAULT_INJECTION=true

# --- Rutas ---
MODEL_DIR=models/vision-1.0.1
# Carpeta que CONTIENE las imágenes objN__A.png (no su carpeta padre)
DATA_DIR=data/raw/coil-100
AGENT_DB_PATH=data/runtime/agent.db
# Backends simulados de planta y checkpoints de LangGraph (por defecto, configs/agent.yaml)
PLANT_DB_PATH=data/runtime/plant.db
AGENT_CHECKPOINT_DB=data/runtime/agent_checkpoints.db

# --- Conexión agente → visión ---
VISION_API_URL=http://localhost:8001
